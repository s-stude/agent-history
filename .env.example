# Copy to .env (git-ignored) and adjust. Precedence: real environment > .env > ~/.agent-history/config.json > defaults.
# Names are prefixed on purpose: hooks run inside the agent's shell, where a project's own DATABASE_URL may be set.

# Database endpoint (owner connection). Put a password in ~/.pgpass, not here.
AGENT_HISTORY_DATABASE_URL=postgresql://localhost:5432/agent_history

# Read-only connection used by the capture check (default: derived from the endpoint with user agent_history_reader).
# AGENT_HISTORY_READER_URL=postgresql://agent_history_reader@localhost:5432/agent_history

# Logs, config.json, markdown exports, backups (default ~/.agent-history).
# AGENT_HISTORY_HOME=/Users/you/.agent-history

# Transcript roots (defaults under CLAUDE_CONFIG_DIR / CODEX_HOME, else ~/.claude and ~/.codex).
# AGENT_HISTORY_CLAUDE_PROJECTS=/Users/you/.claude/projects
# AGENT_HISTORY_CODEX_SESSIONS=/Users/you/.codex/sessions
# AGENT_HISTORY_CODEX_ARCHIVED=/Users/you/.codex/archived_sessions

# Maintenance database used by tests to create and drop agent_history_test_* databases (default: endpoint with /postgres).
# Tests never read .env; set this in the shell if your server is not on localhost:5432.
# AGENT_HISTORY_TEST_SERVER_URL=postgresql://localhost:5432/postgres
